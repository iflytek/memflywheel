# Hermes agent image with memflywheel plugin baked in.
#
# Build context: repo root.
# Expected files in build context:
#   e2e/packages/iflytekopensource-memflywheel-*.tgz
#   e2e/kind/03-memflywheel-install.sh

# Pin the compatibility fixture used by the last successful main-branch run:
# https://github.com/iflytek/memflywheel/actions/runs/36331901720
# Update the digest with a deliberate host-compatibility run, not a moving tag.
FROM nousresearch/hermes-agent@sha256:d4da4a40cd7a28aba983775d9fd31d94cbf153eeb0cb9e844d6d0f612b7c24db

USER root

# Copy the unified memflywheel package
COPY e2e/packages/iflytekopensource-memflywheel-*.tgz /tmp/memflywheel.tgz

# Keep the global prefix aligned with NODE_PATH and the startup entry point.
# The base image may configure a user-specific npm prefix outside s6's PATH.
RUN npm install --global --prefix /usr/local /tmp/memflywheel.tgz \
    && /usr/local/bin/memflywheel-hermes-install --help

# Make globally-installed packages resolvable from any working directory
ENV NODE_PATH=/usr/local/lib/node_modules

# Add cont-init script to install the plugin at container startup.
# HERMES_HOME=/opt/data is a VOLUME, so plugin files installed during build
# would be hidden by the PVC. We re-install at startup to populate the volume.
COPY e2e/kind/03-memflywheel-install.sh /etc/cont-init.d/03-memflywheel-install

# Auto-start gateway on first boot (seed gateway_state.json as "running")
ENV HERMES_GATEWAY_BOOTSTRAP_STATE=running

# Point Hermes LLM at the mock service
ENV OPENAI_API_KEY=mock-key
ENV OPENAI_BASE_URL=http://mock-llm.default.svc.cluster.local:8080/v1

EXPOSE 8642 9119
USER hermes
CMD ["tail", "-f", "/dev/null"]
